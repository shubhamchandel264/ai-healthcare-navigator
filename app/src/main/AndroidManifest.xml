<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AI Healthcare Navigator"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HealthNav">
        <activity android:name=".SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".DashboardActivity" android:exported="false" />
        <activity android:name=".PrescriptionActivity" android:exported="false" />
        <activity android:name=".ReportActivity" android:exported="false" />
        <activity android:name=".SpecialistActivity" android:exported="false" />
        <activity android:name=".HospitalsActivity" android:exported="false" />
        <activity android:name=".CostEstimatorActivity" android:exported="false" />
        <activity android:name=".InsuranceActivity" android:exported="false" />
        <activity android:name=".MedicineInteractionActivity" android:exported="false" />
        <activity android:name=".ExpenseActivity" android:exported="false" />
        <activity android:name=".DocumentsActivity" android:exported="false" />

    </application>

</manifest>