<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_background"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Healthcare Navigator"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your intelligent healthcare guide"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/outline_white"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Stats card -->
        <TextView
            android:id="@+id/tvDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/card_white"
            android:elevation="4dp"
            android:padding="18dp"
            android:text="Loading dashboard..."
            android:textColor="@color/text_dark"
            android:textSize="15sp" />

        <!-- Module grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="12dp">

            <Button
                android:id="@+id/btnPrescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_prescription"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Prescription Simplifier"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_report"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Report Explainer"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSpecialist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_specialist"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Specialist Guide"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHospitals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_hospital"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Hospitals"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_cost"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Cost Estimator"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnInsurance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_insurance"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Insurance Guide"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnInteraction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_interaction"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Interaction Checker"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExpenses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_expense"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Expense Tracker"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@drawable/card_selector"
                android:drawableTop="@drawable/ic_documents"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:padding="18dp"
                android:text="Document Wallet"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

        </GridLayout>

    </LinearLayout>

</ScrollView>